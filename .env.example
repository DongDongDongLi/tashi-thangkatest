# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PayPal — Sandbox for testing, Live for production
PAYPAL_MODE=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret

# Admin panel (/admin)
ADMIN_PASSWORD=change-me-strong-password
# Optional: separate cookie signing secret
# ADMIN_SESSION_SECRET=random-long-string

# Product persistence on Vercel (required to save products in production)
# Create at: Vercel project → Storage → Blob → Create
# BLOB_READ_WRITE_TOKEN=vercel_blob_xxx

# Orders & buyer accounts (Neon Postgres — required for checkout/orders)
# Create free DB at https://neon.tech → copy connection string
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Optional: separate secret for buyer session cookies
# BUYER_SESSION_SECRET=random-long-string

# AfterShip — logistics tracking (China → US)
# https://www.aftership.com/docs/tracking/quickstart/api-quick-start
AFTERSHIP_API_KEY=your_aftership_api_key
# Webhook secret from AfterShip dashboard (optional but recommended)
# AFTERSHIP_WEBHOOK_SECRET=your_webhook_secret
